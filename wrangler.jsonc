{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "season-approved-launch-party-game-master",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "season-approved-launch-party-game-master"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "season-approved-launch-party",
      "database_id": "e08c3860-768b-4bfc-acc0-5adce5d4da19"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SUBMISSIONS",
      "bucket_name": "season-approved-launch-party-submissions"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
